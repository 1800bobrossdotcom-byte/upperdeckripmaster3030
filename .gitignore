node_modules/
.env
.env.sepolia
.env.local
out/
cache/
broadcast/
lib/
*.log
scratch_new/
# large / third-party media — kept out of the static deploy
*.mp4
scripts/.whitepaper.build.html
tmp_naming/
scratchpad_anchors.json
scratchpad_*

# intermediate level OBJs — regenerate with `npm run level`
build/levels/
__pycache__/

# headless-verify screenshots — regenerate with the scratchpad scripts
build/preview/

# game debug sweep output — regenerate with `npm run debug`
build/debug/

# hero wordmark scratch — Blender's working copy plus the .ttf the mesh is cut
# from. `npm run herotype` refills it; the SHIPPED outputs are media/hero/*.
# It was briefly committed (added 4bd7f23, dropped fae16c4) because nothing
# ignored it, which is the whole reason this line exists.
build/hero-type/

# mobile audit screenshots — regenerate with `npm run mobile -- --shots`.
# build/mobile/audit.json is deliberately NOT ignored: it is the committed BEFORE
# snapshot the mobile pass was measured against, and re-runs write audit-latest.json.
build/mobile/*.png
build/mobile/audit-latest.json

# NEON RONIN silhouette rasters — the art director's measurement intermediates, regenerated
# by `npm run test:ronin-art`. Committing 368 KB of .pgm to prove a number that the test
# recomputes anyway is the wrong artifact: keep the assertion, not its scratch paper.
build/ronin-art/
test-results.json

# Standalone game exports — regenerated by `npm run standalone`, never committed.
build/standalone/
build/listing/

# Market-measurement scratch — pool probes, holder scans and hook reads written by the agents
# that audit the live v4 pools. The ARGUMENT belongs in CLAUDE.md and the numbers are re-derivable
# from the chain in one command; committing the throwaway scripts that produced them is the same
# wrong artifact as committing build/ronin-art's .pgm rasters to prove a number the test recomputes.
fwa-audit/
