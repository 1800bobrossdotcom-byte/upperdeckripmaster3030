# Copy to bot/.env on the server. NEVER commit it — bot/.env is gitignored.
#
# The hot key. Fund it with what you can lose; the rails cap a trade at 0.05 ETH, a day at 0.25,
# and refuse to run at all above a 0.20 ETH balance.
BOT_PRIVATE_KEY=0x...

# The ONLY thing that lets it sign. Leave it commented out until the dry run has convinced you.
# LIVE=1

# Optional. Defaults to two public endpoints that serve eth_getLogs — note that the site's own
# chain-config list does NOT (publicnode rejects it outright, merkle says the method is absent).
# RPC_URLS=https://your-node,https://backup-node

# Optional. 60000 = a tick a minute.
# TICK_MS=60000
