{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "3030\\.ripmaster3030studios\\.com"
        }
      ],
      "destination": "/check.html",
      "permanent": false
    },
    {
      "source": "/sheet.html",
      "destination": "/substrate.html",
      "permanent": false
    },
    {
      "source": "/drain.html",
      "destination": "/3030.html",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?upperdeckripmaster3030\\.com"
        }
      ],
      "destination": "https://ripmaster3030studios.com/:path*",
      "permanent": true
    },
    {
      "source": "/cards/:id((?:[1-9]|[12][0-9]|3[0-3]))",
      "destination": "/cards/hero/:id.html",
      "permanent": false
    },
    {
      "source": "/cards/:id((?:3[4-9]|[4-9][0-9]|100))",
      "destination": "/cards/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/cards/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
